# Copiar a .env y rellenar. Nunca commitear .env con valores reales.

ENVIRONMENT=testnet            # testnet | live
MODE=technical_only            # technical_only | technical_plus_fundamental | full

# --- Universo ---
UNIVERSE=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT
CORE_ASSETS=BTCUSDT,ETHUSDT

# --- Modo manual (/analiza) ---
MANUAL_MAX_PER_HOUR=10
MANUAL_MIN_CANDLES_1H=500

# --- Scanner / filtros duros ---
SCAN_INTERVAL_MINUTES=15
MIN_QUOTE_VOL_24H=50000000
MAX_SPREAD_BPS=5
MIN_ABS_CHANGE_PCT=3.0
RANGE_LOOKBACK_CANDLES=20
VOLUME_CONFIRM_MULT=1.5
PAPER_STARTING_EQUITY_USDT=10000

# --- Risk engine ---
RISK_PER_TRADE=0.005
MAX_POSITIONS=3
MAX_EXPOSURE_TOTAL=0.30
MAX_EXPOSURE_BTC_BETA=0.20
DAILY_LOSS_LIMIT=0.02
DRAWDOWN_KILLSWITCH=0.10
COOLDOWN_ASSET_HOURS=12
COOLDOWN_AFTER_2SL_HOURS=24
MIN_RR_NET=1.8
TAKER_FEE=0.001

# --- Ejecución ---
ENTRY_TTL_MINUTES=45
MAX_HOLD_HOURS_INTRADAY=48
MAX_HOLD_DAYS_SWING=7

# --- LLM / fundamental (fase 2+) ---
USE_REMOTE_LLM=false
OLLAMA_MODEL=qwen3.5:9b
# Ollama corriendo en el HOST (no en docker-compose) — host.docker.internal
# funciona sin configuración extra en Docker Desktop (Windows/Mac).
OLLAMA_HOST=http://host.docker.internal:11434
FUNDAMENTAL_CLASSIFY_BATCH_SIZE=10
FUNDAMENTAL_VETO_HOURS=24
# Memo LLM opcional (fase 3, sección 13) — solo redacta, nunca decide.
# Sin API key, no hace nada (no falla) aunque USE_REMOTE_LLM=true.
REMOTE_LLM_API_KEY=
REMOTE_LLM_MODEL=claude-haiku-4-5-20251001

# --- Reddit OAuth Data API (fase 2, ingesta social) ---
# Crear en https://www.reddit.com/prefs/apps -> "create app" -> tipo "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trading-lab/0.1 (fundamental ingest)

# --- Capital real (fase 4, gate obligatorio) ---
LIVE_MAX_CAPITAL=0             # debe fijarlo el usuario explícitamente

# --- Base de datos ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading_lab
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading_lab

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Binance (testnet y live separadas) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
